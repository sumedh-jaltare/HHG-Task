# Public site origin — used for metadataBase and absolute OG URLs.
# Set this to the preview or production URL on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Exact Vercel Blob hostname allowed as og:image on /s.
# Copy the host from a successful share URL
# (https://<this-host>/shares/<uuid>.png), or from the Vercel
# Storage dashboard. If unset, any *.blob.vercel-storage.com host
# is accepted.
NEXT_PUBLIC_BLOB_HOSTNAME=

# Required for POST /api/upload-share.
# Created automatically when a Blob store is attached to the project.
#   vercel blob store add
#   vercel env pull
BLOB_READ_WRITE_TOKEN=
